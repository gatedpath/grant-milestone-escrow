    address internal constant TESTNET_ACCREDITED_ISSUER_REGISTRY = 0x6aEe06F4052ff6d01Ed7E13Fa5Ab53675756A057;

    /// @dev Safe 1.4.1 canonical deployments, present on 151 and 153.
    address internal constant SAFE_SINGLETON = 0x41675C099F32341bf84BFc5382aF534df5C7461a;
    address internal constant SAFE_L2_SINGLETON = 0x29fcB43b46531BcA003ddC8FCB67FFE91900C762;
