    address internal constant BOOTSTRAP_REGISTRY = 0xDAFEA492D9c6733ae3d56b7Ed1ADB60692c98Bc5;

    address internal constant MAINNET_PERMISSION = 0xcb385cD90ca6b219798F57B4a7958897e91A9163;
